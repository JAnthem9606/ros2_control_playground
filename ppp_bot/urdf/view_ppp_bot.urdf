<?xml version="1.0"?>
<robot name="three_prismatic_robot">
  <!-- ===================== -->
  <!-- Materials -->
  <!-- ===================== -->
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <material name="green">
    <color rgba="0 1 0 1"/>
  </material>
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <!-- ===================== -->
  <!-- Base Link -->
  <!-- ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 1"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>
  <!-- ===================== -->
  <!-- Link 1 -->
  <!-- ===================== -->
  <link name="link1">
    <visual>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1 0.05 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <!-- ===================== -->
  <!-- Link 2 -->
  <!-- ===================== -->
  <link name="link2">
    <visual>
      <origin xyz="0 0.5 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 1 0.05"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>
  <!-- ===================== -->
  <!-- End Effector -->
  <!-- ===================== -->
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.20"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>
  <!-- ===================== -->
  <!-- Joint 1 (Prismatic X) -->
  <!-- ===================== -->
  <joint name="joint1" type="prismatic">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit
      lower="0.0"
      upper="2"
      effort="100"
      velocity="0.2"/>
  </joint>
  <!-- ===================== -->
  <!-- Joint 2 (Prismatic Y) -->
  <!-- ===================== -->
  <joint name="joint2" type="prismatic">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit
      lower="0.0"
      upper="2"
      effort="100"
      velocity="0.2"/>
  </joint>
  <!-- ===================== -->
  <!-- Joint 3 (Prismatic Z) -->
  <!-- ===================== -->
  <joint name="joint3" type="prismatic">
    <parent link="link2"/>
    <child link="tool0"/>
    <origin xyz="0 1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit
      lower="0.0"
      upper="2"
      effort="100"
      velocity="0.2"/>
  </joint>

</robot>
