<?xml version="1.0"?>
<robot name="scara_bot">

  <!-- ===================== -->
  <!-- Materials -->
  <!-- ===================== -->
  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 1.0 0.0 1.0"/>
  </material>

  <!-- ===================== -->
  <!-- Base -->
  <!-- ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 2"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 2"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================== -->
  <!-- Link 1 -->
  <!-- ===================== -->
  <link name="link1">
    <visual>
      <origin xyz="0 0.5 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 1 0.1"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0.5 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 1 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================== -->
  <!-- Link 2 -->
  <!-- ===================== -->
  <link name="link2">
    <visual>
      <origin xyz="0.05 0.5 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 1 0.1"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <origin xyz="0.05 0.5 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 1 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="0.05 0.05 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.5"/>
          </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0.05 0.05 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.5"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================== -->
  <!-- Joint 1 -->
  <!-- ===================== -->
  <joint name="joint1" type="continuous">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.7" friction="0.1"/>
    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="10"
      velocity="1.0"/>
  </joint>

  <!-- ===================== -->
  <!-- Joint 2 -->
  <!-- ===================== -->
  <joint name="joint2" type="continuous">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.7" friction="0.1"/>
    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="10"
      velocity="1.0"/>
  </joint>

<joint name="joint3" type="prismatic">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.7" friction="0.1"/>
    <limit
      lower="-0.5"
      upper="0.5"
      effort="10"
      velocity="1.0"/>
  </joint>

  <!-- ===================== -->
  <!-- ros2_control -->
  <!-- ===================== -->
  <ros2_control name="scara_bot" type="system">

    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-2</param>
        <param name="max">2</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


  </ros2_control>
</robot>
